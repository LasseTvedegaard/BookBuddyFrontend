# Brug officiel Node-billede
FROM node:20

# Sæt arbejdsmappen
WORKDIR /app

# 👇 Gør build-arg tilgængelig som miljøvariabel
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# Installer afhængigheder
COPY package*.json ./
RUN npm install

# Kopiér resten (fallback hvis volume ikke mountes)
COPY . .

# Start React dev-server (med hot reload)
CMD ["npm", "start"]
